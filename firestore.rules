rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザープロフィール
    match /userProfiles/{userId} {
      // 誰でも読み取り可能（メンバー表示用）
      allow read: if true;
      // 本人のみ書き込み可能
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 旅行
    match /trips/{tripId} {
      // IDを知っていれば読み取り可能（招待リンク・ID参加用）
      allow read: if true;

      // 作成は認証済みユーザーなら誰でも可能
      allow create: if request.auth != null;

      // 更新はメンバー、または参加処理（自分をmembersに追加）
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']) &&
        request.auth.uid in request.resource.data.members)
      );

      // 削除はメンバーのみ
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // チャットメッセージ（サブコレクション）
      match /messages/{messageId} {
        // 親ドキュメント（trip）のメンバーであれば読み書き可能
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }

      // カード（サブコレクション）
      match /cards/{cardId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }

      // プラン（サブコレクション）
      match /plans/{planId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }
    }

    // ゲストセッション（匿名認証用）
    match /guestSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == sessionId;
    }
  }
}
